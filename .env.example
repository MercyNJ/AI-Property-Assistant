# Copy to backend/.env (or .env at the repo root) and fill in. Never commit the real file.

# Required for /api/chat
OPENAI_API_KEY=

# Any Responses API model that supports function calling and structured outputs.
OPENAI_MODEL=gpt-5.4-mini
# low | medium | high. Leave empty for non-reasoning models (e.g. gpt-4.1-mini).
OPENAI_REASONING_EFFORT=low
OPENAI_TIMEOUT=45

# Defaults to SQLite at backend/properties.db. A Postgres URL also works (add psycopg to requirements).
# DATABASE_URL=sqlite:///./properties.db

# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# User turns of conversation history sent to the model.
MAX_HISTORY_TURNS=10

# /api/chat rate limits: per client IP, plus a global daily cap.
CHAT_LIMIT_PER_MINUTE=10
CHAT_LIMIT_PER_DAY=100
CHAT_LIMIT_GLOBAL_PER_DAY=1000
